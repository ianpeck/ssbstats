# Copy this file to secrets.env and fill in your actual credentials
# DO NOT commit secrets.env to git!

awsendpoint=your-rds-endpoint.region.rds.amazonaws.com
awsuser=your_database_username
awspassword=your_database_password
awsdb=SmashBros
awswriteuser=your_schedule_write_username
awswritepassword=your_schedule_write_password
SECRET_KEY=replace_with_a_long_random_secret
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.20
GROQ_API_KEY=your_groq_api_key
